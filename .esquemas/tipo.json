{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "description": "Nombre del tipo en singular (Máquina)"
    },
    "plural": {
      "type": "string",
      "minLength": 1,
      "description": "Nombre del tipo en plural (Máquinas)"
    },
    "icono": {
      "description": "Icono de Lucide (server, box, map-pin…)",
      "type": "string",
      "minLength": 1
    },
    "descripcion": {
      "description": "Qué entra en este tipo y qué no",
      "type": "string",
      "minLength": 1
    },
    "etiqueta": {
      "description": "El campo que se muestra como nombre de cada entidad. Si falta, su id",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "campos": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      },
      "description": "Los campos, cada uno con su `tipo`"
    },
    "vista": {
      "description": "Cómo se muestra la lista del tipo",
      "type": "object",
      "properties": {
        "columnas": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "Columnas de la tabla del tipo, en orden"
        }
      },
      "required": ["columnas"],
      "additionalProperties": false
    }
  },
  "required": ["nombre", "plural", "campos"],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "texto",
                "numero",
                "entero",
                "booleano",
                "fecha",
                "url",
                "email",
                "ip",
                "ficha"
              ],
              "description": "Tipo del campo. `ficha` es la ruta de una página de docs/ (contenedores/komodo)"
            },
            "opcional": {
              "description": "true si el campo puede faltar. Por defecto es obligatorio",
              "type": "boolean"
            },
            "descripcion": {
              "description": "Para qué sirve el campo. Sale como ayuda en el editor y la lee la IA",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tipo"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "const": "enum",
              "description": "Uno de los valores de `valores`"
            },
            "valores": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Los valores que admite el campo"
            },
            "opcional": {
              "description": "true si el campo puede faltar. Por defecto es obligatorio",
              "type": "boolean"
            },
            "descripcion": {
              "description": "Para qué sirve el campo. Sale como ayuda en el editor y la lee la IA",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tipo", "valores"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "const": "ref",
              "description": "El id de una entidad de otro tipo del catálogo"
            },
            "a": {
              "type": "string",
              "enum": ["maquinas", "servicios", "stacks", "ubicaciones"],
              "description": "El tipo al que apunta: el nombre de su carpeta"
            },
            "opcional": {
              "description": "true si el campo puede faltar. Por defecto es obligatorio",
              "type": "boolean"
            },
            "descripcion": {
              "description": "Para qué sirve el campo. Sale como ayuda en el editor y la lee la IA",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tipo", "a"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "const": "lista",
              "description": "Varios valores; `de` es el campo que se repite"
            },
            "de": {
              "$ref": "#/definitions/__schema0"
            },
            "opcional": {
              "description": "true si el campo puede faltar. Por defecto es obligatorio",
              "type": "boolean"
            },
            "descripcion": {
              "description": "Para qué sirve el campo. Sale como ayuda en el editor y la lee la IA",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tipo", "de"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "const": "objeto",
              "description": "Un grupo de campos con nombre"
            },
            "campos": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/definitions/__schema0"
              },
              "description": "Los campos, cada uno con su `tipo`"
            },
            "opcional": {
              "description": "true si el campo puede faltar. Por defecto es obligatorio",
              "type": "boolean"
            },
            "descripcion": {
              "description": "Para qué sirve el campo. Sale como ayuda en el editor y la lee la IA",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["tipo", "campos"],
          "additionalProperties": false
        }
      ]
    }
  },
  "title": "Tipo del catálogo"
}
