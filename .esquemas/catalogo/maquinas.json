{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "description": "Solo si se escribe distinto del id (PVE-01)"
    },
    "ip": {
      "anyOf": [
        {
          "type": "string",
          "format": "ipv4",
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
        },
        {
          "type": "string",
          "format": "ipv6",
          "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
        }
      ]
    },
    "ubicacion": {
      "type": "string",
      "enum": ["casa", "hetzner"]
    },
    "clase": {
      "type": "string",
      "enum": ["fisica", "vm", "vps"]
    },
    "anfitrion": {
      "type": "string",
      "enum": ["docker-01", "nas", "pve-01", "vps-01"],
      "description": "La máquina física donde corre, si es una vm"
    },
    "so": {
      "type": "string",
      "minLength": 1,
      "description": "Sistema operativo y versión (Debian 13)"
    },
    "uso": {
      "type": "string",
      "minLength": 1,
      "description": "Una línea con para qué sirve"
    },
    "ficha": {
      "type": "string",
      "enum": [
        "contenedores",
        "contenedores/komodo",
        "contenedores/komodo/nuevo-stack",
        "copias",
        "copias/duplicati",
        "copias/duplicati/crear-backup",
        "empezar",
        "red",
        "red/dns"
      ],
      "description": "La ficha que la explica, si la tiene"
    },
    "fuente": {
      "description": "De dónde sale el dato: manual, o la conexión de la que se importó (komodo)",
      "type": "string",
      "minLength": 1
    },
    "actualizado": {
      "description": "Fecha del dato, AAAA-MM-DD",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": ["ip", "ubicacion", "clase", "so", "uso"],
  "additionalProperties": false,
  "title": "Máquina",
  "description": "Servidores físicos, máquinas virtuales y VPS. El id es el hostname en minúsculas"
}
