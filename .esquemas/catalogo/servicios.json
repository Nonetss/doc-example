{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1
    },
    "categoria": {
      "type": "string",
      "enum": ["red", "contenedores", "copias", "identidad", "monitorizacion"]
    },
    "estado": {
      "type": "string",
      "enum": ["documentado", "parcial", "pendiente"],
      "description": "Cuánto está documentado, no si funciona"
    },
    "resumen": {
      "type": "string",
      "minLength": 1,
      "description": "Una línea con qué es"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "maquina": {
      "type": "string",
      "enum": ["docker-01", "nas", "pve-01", "vps-01"],
      "description": "Donde corre"
    },
    "ficha": {
      "type": "string",
      "enum": [
        "contenedores",
        "contenedores/komodo",
        "contenedores/komodo/nuevo-stack",
        "copias",
        "copias/duplicati",
        "copias/duplicati/crear-backup",
        "empezar",
        "red",
        "red/dns"
      ]
    },
    "fuente": {
      "description": "De dónde sale el dato: manual, o la conexión de la que se importó (komodo)",
      "type": "string",
      "minLength": 1
    },
    "actualizado": {
      "description": "Fecha del dato, AAAA-MM-DD",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": ["nombre", "categoria", "estado", "resumen", "maquina"],
  "additionalProperties": false,
  "title": "Servicio",
  "description": "Cada aplicación o pieza de infraestructura que se documenta"
}
